# Copy to .env (never commit .env). docker compose reads it automatically.
DEEPSEEK_API_KEY=
# deepseek-flash (default) or deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# Change these for anything beyond local development.
CALLER_SECRET=dev-caller-secret-change-me
SESSION_SECRET=dev-session-secret-change-me
